# Root configuration, loaded by API/Worker/Prisma; never commit .env.
DATABASE_URL=postgresql://whats_new:whats_new_dev@localhost:5432/whats_new?schema=public
REDIS_URL=redis://localhost:6379
API_PORT=4000
WEB_ORIGIN=http://localhost:3000
API_INTERNAL_URL=http://localhost:4000/api/v1
NEXT_PUBLIC_API_URL=/api/v1
AUTH_MODE=dev
DEV_USER_ID=00000000-0000-4000-8000-000000000001
ADMIN_USER_IDS=00000000-0000-4000-8000-000000000001
AI_MODE=fake
# fixture keeps the independent process alive without infrastructure.
# queue consumes only the M0 fixture-smoke queue; business queues arrive in M2.
WORKER_MODE=fixture
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=
OPENAI_EXTRACTION_MODEL=
OPENAI_EMBEDDING_MODEL=
EMBEDDING_DIMENSIONS=
GITHUB_TOKEN=
AUTH_SECRET=
SYNC_INTERVAL_MINUTES=60
BACKFILL_DAYS=90
MAX_AGENT_STEPS=8
AGENT_TIMEOUT_MS=120000
LOG_LEVEL=info
