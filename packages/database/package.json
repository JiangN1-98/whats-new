{
  "name": "@whats-new/database",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "prisma generate && tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint src prisma/seed.ts prisma.config.ts",
    "db:generate": "prisma generate",
    "db:validate": "prisma validate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "7.10.0",
    "@prisma/adapter-pg": "7.10.0",
    "pg": "8.23.1",
    "@whats-new/config": "workspace:*"
  },
  "devDependencies": {
    "typescript": "6.0.3",
    "@types/node": "24.19.1",
    "@whats-new/tsconfig": "workspace:*",
    "@whats-new/eslint-config": "workspace:*",
    "eslint": "9.39.4",
    "prisma": "7.10.0",
    "tsx": "4.23.15",
    "@types/pg": "8.23.1"
  }
}
